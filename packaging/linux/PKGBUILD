# Builds mint from a checkout of this repository: `makepkg -si` in packaging/linux.
pkgname=mint
pkgver=0.1.0
pkgrel=1
pkgdesc="Password generator: CLI, window and 1Password save"
arch=('x86_64' 'aarch64')
url="https://github.com/steveclarke/mint"
license=('MIT')
depends=('webkit2gtk-4.1' 'libayatana-appindicator' 'wl-clipboard')
makedepends=('cargo')
optdepends=('1password-cli: save to 1Password')

build() {
  cd "$startdir/../.."
  cargo build --release --locked -p mint-cli -p mint-app
}

package() {
  cd "$startdir/../.."
  install -Dm755 target/release/mint "$pkgdir/usr/bin/mint"
  install -Dm755 target/release/mint-app "$pkgdir/usr/bin/mint-app"
  install -Dm644 packaging/linux/mint.desktop "$pkgdir/usr/share/applications/mint.desktop"
  install -Dm644 crates/mint-app/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/mint.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
