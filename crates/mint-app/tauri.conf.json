{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mint",
  "mainBinaryName": "mint-app",
  "version": "0.1.0",
  "identifier": "io.github.steveclarke.mint",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "mint",
        "width": 460,
        "height": 470,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "focus": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "center": true,
        "windowEffects": {
          "effects": ["popover", "acrylic"],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "shortDescription": "Password generator",
    "copyright": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
